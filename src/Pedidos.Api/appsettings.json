{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Banco": {
    "Provedor": "Sqlite",
    "AplicarMigrations": true
  },
  "Mensageria": {
    "Provedor": "Memoria"
  },
  "Cache": {
    "Provedor": "Memoria"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=pedidos.db",
    "Postgres": "Host=localhost;Port=5432;Database=pedidos;Username=pedidos;Password=pedidos",
    "RabbitMq": "amqp://pedidos:pedidos@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Jwt": {
    "Emissor": "pedidos-api",
    "Audiencia": "pedidos-clientes",
    "Chave": "chave-de-desenvolvimento-troque-em-producao-0123456789"
  },
  "Auth": {
    "Usuario": "admin",
    "Senha": "admin"
  },
  "RateLimit": {
    "PorMinuto": 120
  },
  "AllowedHosts": "*"
}
